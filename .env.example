# ═══════════════════════════════════════════════════════════════════════════════
# IntelliCam-SmartCCTV — Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════════

# ─── 1. SERVER CONFIGURATION ─────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=False
# Optional: your public cloud URL if hosted (e.g. https://your-cctv.onrender.com)
BASE_EXTERNAL_URL=

# ─── 2. SUPABASE CLOUD DATABASE & STORAGE (No Laptop Server) ─────────────────
# Get these from your Supabase Dashboard -> Project Settings -> API & Database
# Database Connection String (Direct or Pooled PostgreSQL):
# postgresql+psycopg2://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=

# Supabase API URL & Anon/Service Role Key (for Cloud Storage):
SUPABASE_URL=https://kuoljbtuexxqfvhkjsdc.supabase.co
SUPABASE_KEY=your_supabase_secret_service_role_key
SUPABASE_BUCKET_SNAPSHOTS=cctv-snapshots
SUPABASE_BUCKET_RECORDINGS=cctv-recordings

# ─── 3. CLOUD CAMERA PUSH WEBHOOK (Zero-Laptop Alerts) ───────────────────────
# IP cameras or phone camera apps can HTTP POST motion snapshots directly to:
# http(s)://<your-host>/api/camera-webhook?api_key=cctv-camera-secret-key
WEBHOOK_API_KEY=cctv-camera-secret-key

# ─── 4. TELEGRAM NOTIFICATIONS (100% Free & Instant with Photos) ─────────────
# 1. Message @BotFather on Telegram -> create bot -> get TELEGRAM_BOT_TOKEN
# 2. Message @userinfobot on Telegram to get your numeric TELEGRAM_CHAT_ID
TELEGRAM_ENABLED=True
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# ─── 5. WHATSAPP NOTIFICATIONS ───────────────────────────────────────────────
# Option A: Twilio WhatsApp (Recommended & easiest)
WHATSAPP_ENABLED=False
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+919876543210

# Option B: Meta WhatsApp Cloud API (Alternative)
# WHATSAPP_PROVIDER=meta
# META_WHATSAPP_TOKEN=your_meta_token
# META_WHATSAPP_PHONE_ID=your_phone_number_id

# ─── 6. AI & DETECTION SETTINGS ──────────────────────────────────────────────
YOLO_MODEL=yolov8n.pt
MOTION_THRESHOLD=25
MOTION_MIN_AREA=500
OBJECT_CONFIDENCE=0.5
DETECTION_INTERVAL=0.5
TRACKER_MAX_AGE=30
TRACKER_MIN_HITS=2
TRACKER_IOU_THRESHOLD=0.3
TRACKER_DRAW_TRAILS=True
STREAM_OVERLAY=True
